{
  "name":"BYO Freedom scoped native transcript and runtime deletion",
  "version":1,
  "steps":[
    {"name":"Authorize owned builder deletion","type":"code","function":"freedomtools.builderDeletionPrepare.v1","description":"Pin the trusted project and owner; native targets resolve from the exact dedicated conversation binding.","input":{"pick":{"requestId":"$.requestId","projectId":"$.projectId","ownerPubkey":"$.ownerPubkey","generation":"$.generation","conversationKey":"$.conversationKey","expectedNativeSessionId":"$.expectedNativeSessionId","expectedWingmanSessionId":"$.expectedWingmanSessionId"}},"assign":"$.authorizedDeletion","display":{"in":[{"label":"Project","path":"$.projectId","format":"text"}],"out":[{"label":"Conversation","path":"$.conversationKey","format":"text"}]}},
    {"name":"Delete owned native transcript and runtime","type":"code","function":"session.deleteConversation","description":"Fence active/uncertain turns; stop the owned dedicated runtime and remove its transcript/runtime/archive records. Provider metadata indexes remain.","input":{"pick":{"requestId":"$.authorizedDeletion.requestId","projectId":"$.authorizedDeletion.projectId","conversationKey":"$.authorizedDeletion.conversationKey","directory":"$.authorizedDeletion.directory","confirmation":"$.authorizedDeletion.confirmation"}},"assign":"$.deletion","display":{"in":[{"label":"Conversation","path":"$.conversationKey","format":"text"}],"out":[{"label":"Runtime records deleted","path":"$.runtimeStorageDeleted"},{"label":"Transcript deleted","path":"$.nativeTranscriptDeleted"},{"label":"Full native storage deleted","path":"$.nativeStorageDeleted"}]}},
    {"name":"Return correlated component receipt","type":"code","function":"freedomtools.builderDeletionCandidate.v1","description":"Return truthful component deletion evidence for the WApp generation; app message history is preserved.","input":{"pick":{"requestId":"$.requestId","projectId":"$.projectId","generation":"$.generation","conversationKey":"$.conversationKey","expectedNativeSessionId":"$.expectedNativeSessionId","expectedWingmanSessionId":"$.expectedWingmanSessionId","deletion":"$.deletion"}},"display":{"in":[{"label":"Deletion receipt","path":"$.deletion.receiptId","format":"text"}],"out":[{"label":"Result","path":"$.action","format":"text"}]}}
  ]
