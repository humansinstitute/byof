# Public identity configuration; no private keys belong here.
FREEDOM_HOST_NPUB=
FREEDOM_ORIGIN=https://your-managed-wapp.example
FREEDOM_DATA_DIR=tmp/runtime
FREEDOM_VERSION=0.1.0
# Managed runner supplies PORT.
# Public pinned Autopilot delivery signer, discovered over authenticated API.
FREEDOM_CALLBACK_SIGNER_PUBKEY=
# Optional host-only approved-request execution. JSON contains public configuration
# and a path to a managed opaque capability file; never its credential value.
# Keys: brokerUrl, credentialFile, origin, definitionId, callbackUrl, appPubkey,
# approvedRequestId. Pin the exact request/project/prompt in the installed definition.
FREEDOM_OPERATOR_BUILD_CONFIG=

# Trusted owner/project follow-ups: installation broker config plus projectId, ownerPubkey, conversationKey.
# Keep credentials server-local. General participant execution requires verified isolation.
FREEDOM_FOLLOWUP_CONFIG=

# Absolute Napplet root on the Autopilot host. Run scripts/napplet-setup.ts first
# to persist the authoritative workshop ID and migrate existing scoped folders.
FREEDOM_NAPPLET_ROOT=

# Public site administrator identities, comma-separated. Workshop owners do not
# become site administrators. FREEDOM_HOST_NPUB also bootstraps site ownership.
FREEDOM_ADMIN_NPUBS=
# Legacy exact managed private-storage configuration (see roles-workshops-contract).
FREEDOM_STORAGE_CONFIG=
# Optional array of separately provisioned StorageConfig values, pinned to an
# explicit workshop UUID and selected Tower origin. Never include raw credentials.
FREEDOM_WORKSHOP_STORAGE_CONFIG=

# Operator-approved per-Tower connectors for automatic additional workshop setup.
# Run scripts/storage-template-setup.ts with the pinned managed grant receipt.
FREEDOM_STORAGE_TEMPLATES=
