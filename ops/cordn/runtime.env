CORDN_RELAY_URLS=wss://relay.contextvm.org,wss://relay2.contextvm.org
CORDN_SERVER_NAME=Pete Cordn coordinator
CORDN_ANNOUNCED=false
CORDN_STORAGE_BACKEND=sqlite
